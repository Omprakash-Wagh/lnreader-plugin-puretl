# NOTE: .dist and .js are intentionally TRACKED in this custom repository
# so that LNReader can download the manifest (.dist/plugins.min.json) and
# compiled plugin bundle (.js/src/plugins/english/pureLoveTranslations.js)
# directly via raw.githubusercontent.com URLs.
